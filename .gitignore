# ── Python ──────────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*$py.class
*.so
.Python

# ── Build / packaging ───────────────────────────────────────────────────
build/
dist/
*.egg-info/
*.egg
pip-wheel-metadata/
.installed.cfg

# ── uv / pip ────────────────────────────────────────────────────────────
# Lockfile is committed (uv.lock); ignore caches and venvs
.venv/
.venv*/
venv/
env/
.python-version

# ── Test / coverage ─────────────────────────────────────────────────────
.pytest_cache/
.tox/
.coverage
.coverage.*
htmlcov/
coverage.xml
.hypothesis/
.ruff_cache/
.mypy_cache/

# ── IDE / OS ────────────────────────────────────────────────────────────
.idea/
.vscode/
*.swp
.DS_Store
Thumbs.db

# ── Project-specific ────────────────────────────────────────────────────
# Pipeline outputs (regenerated by running the lib)
products/

# Raw data (never commit; supplied by user per-payload)
14、15B标定数据/
*.event.dat
*.hk
*.event.png
*.ecu_*.png

# One-off cleanup / dev scripts (not part of the library API)
fix_*.py
tools/_*.py

# Editor backups
*.bak
*.orig
